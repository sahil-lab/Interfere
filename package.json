{
  "name": "interfere",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace @interfere/web",
    "build": "npm run build --workspace @interfere/web",
    "verify": "npm run format:check && npm test && npm run build",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/smoke.test.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "prettier": "3.9.10"
  }
}
